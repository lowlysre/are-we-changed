{
  "name": "what-changed",
  "version": "0.1.0",
  "description": "Zero-dependency GitHub Action that reports the files changed between two commits.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage",
    "typecheck": "tsc",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.json\" \"*.yml\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.json\" \"*.yml\" \".github/**/*.yml\""
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.10.0",
    "typescript": "^7.0.2"
  }
}
